#!/command/with-contenv sh
# Runs as root (via s6) then drops privileges to the modbus2mqtt user.
# MODBUS2MQTT_DATA_CONFIG=1 => all configuration lives under /data (persistent).
cd /var/lib/modbus2mqtt || { echo "ERROR: Cannot access home directory"; exit 1; }
export HOME=/var/lib/modbus2mqtt
if [ "$MODBUS2MQTT_DATA_CONFIG" = "1" ]; then
    CONFIG_DIR="/data/config"
else
    CONFIG_DIR="/config"
fi
s6-setuidgid modbus2mqtt /usr/local/bin/modbus2mqtt -c "$CONFIG_DIR" -d /data -s /ssl 2>&1
[ $? -ne 0 ] && echo "modbus2mqtt exited with error code $?" 2>&1
